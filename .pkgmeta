package-as: BetterBonusRolls

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  Libs/LibModernSettings:
    url: https://github.com/KyleCRat/LibModernSettings.git
    tag: 1.5.0
  Libs/LibSimpleDB:
    url: https://github.com/KyleCRat/LibSimpleDB.git
    tag: 2.0.0

ignore:
  - .pkgmeta
  - .editorconfig
  - .gitattributes
  - .git
  - AGENTS.md
  - PLAN.md
  - ICON.png
  - tests
  - "Libs/LibModernSettings/tests"
  - "Libs/LibSimpleDB/benchmarks"
  - "Libs/LibSimpleDB/tests"
