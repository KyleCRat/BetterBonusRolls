package-as: BetterBonusRolls

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  Libs/LibModernSettings-1.0:
    url: https://github.com/KyleCRat/LibModernSettings.git
    tag: 1.10.0
  Libs/LibSimpleDB:
    url: https://github.com/KyleCRat/LibSimpleDB.git
    tag: 2.0.0
  Libs/LibChangelog-1.0:
    url: https://github.com/KyleCRat/LibChangelog.git
    tag: 1.0.1

ignore:
  - AGENTS.md
  - TODO.md
  - BONUS_ROLL_FINDINGS.md
  - selene.toml
  - wow.yml
  - ICON.png
  - tests
  - "Libs/LibModernSettings-1.0/tests"
  - "Libs/LibModernSettings-1.0/Media/Textures/common-button-tertiary-square-mask.afphoto"
  - "Libs/LibSimpleDB/benchmarks"
  - "Libs/LibSimpleDB/tests"
  - "Libs/LibChangelog-1.0/AGENTS.md"
  - "Libs/LibChangelog-1.0/selene.toml"
  - "Libs/LibChangelog-1.0/wow.yml"
  - "Libs/LibChangelog-1.0/tests"
  - "Libs/LibChangelog-1.0/tools"
  - "Libs/LibChangelog-1.0/examples"
